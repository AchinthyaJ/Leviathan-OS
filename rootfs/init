#!/bin/sh

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

echo "================================"
echo "        LEVIATHAN INIT"
echo "================================"
echo
echo "Root filesystem mounted."
echo "Devices initialized."
echo "Launching Leviathan Rust UI Graphics Subsystem (60 FPS)..."
echo

/bin/leviathan-ui

export PS1='leviathan# '
exec /bin/getty
