# Swaylock configuration for Leviathan OS
# Cyber / Oceanic Theme matching Noctalia

image=/usr/share/noctalia/assets/default-wallpaper.png
scaling=fill

# Daemonize
daemonize

# Indicator dimensions
indicator-radius=120
indicator-thickness=10
indicator-idle-visible

# Ring & inside styling
inside-color=0b0f19cc
ring-color=61afeeff
line-uses-inside

# Keypress animation highlights (Cyan / Magenta)
key-hl-color=00e5ffff
bs-hl-color=ff007fff
separator-color=00000000

# Verifying state
inside-ver-color=1b2b48dd
ring-ver-color=00d4ffff
text-ver-color=ffffffcc

# Wrong password state
inside-wrong-color=3b111ddd
ring-wrong-color=ff3366ff
text-wrong-color=ff6688ff

# Clear state
inside-clear-color=1f2335dd
ring-clear-color=e5c07bff
text-clear-color=abb2bfff

# Font
font=JetBrains Mono
font-size=20
text-color=e0e6f8ff
show-failed-attempts
ignore-empty-password
